{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/archive-audit",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/backup-daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/backup-monthly",
      "schedule": "0 2 1 * *"
    }
  ]
}
