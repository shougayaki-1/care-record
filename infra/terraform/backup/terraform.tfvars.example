project_id          = "replace-with-gcp-project-id"
environment         = "staging"
github_repository   = "replace-owner/care-record"
bucket_name_prefix  = "care-record"
github_refs = [
  "refs/heads/main",
]

# Keep false until a saved terraform plan has been reviewed and approved.
# Changing this to true permanently prevents retention policy reduction/removal.
enable_bucket_lock = false

# Additive migration; enable only after checking both environments' live locks.
enable_tiered_backups  = false
enable_tier_bucket_lock = false
