# アプリケーションの実行時設定です。ローカル開発では、このファイルを .env.local にコピーしてください。
# StagingとProductionの値は、それぞれ別のVercelプロジェクト／環境に設定してください。
APP_ENV=local
AI_IMPORT_ENABLED=false
# ローカルの通常開発ではfalse。連携試験では専用のローカル設定を使う。
# Productionではtrue。Stagingでは利用する連携に応じて設定する。
EXTERNAL_INTEGRATIONS_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# staging/productionではURLのproject refと一致させる。
EXPECTED_SUPABASE_PROJECT_ID=

# サーバー専用です。NEXT_PUBLIC_ を付けて公開しないでください。
GAS_API_URL=
GAS_SHARED_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 鍵ローテーション用。例: {"2026-01":"base64...","2026-07":"base64..."}
# 新規暗号化はACTIVE_KEY_IDを使用し、復号中の旧鍵はkeyringへ残す。
GOOGLE_TOKEN_ENCRYPTION_KEYS=
GOOGLE_TOKEN_ACTIVE_KEY_ID=
AUDIT_IP_HASH_SALT=
# 保持期間切れデータ消去ジョブ(/api/cron/purge)の認可シークレット。Vercel Cron と共有する。
CRON_SECRET=

# 任意。設定した場合は application/octet-stream を受け取り {"clean": true} を返す検査サービス。
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# 別アカウント/WORM相当の監査アーカイブ受信先。署名検証と重複排除を実装すること。
AUDIT_ARCHIVE_URL=
AUDIT_ARCHIVE_HMAC_SECRET=

# Google Cloud Storage バックアップ
GCP_PROJECT_ID=
# staging/productionではGCP_PROJECT_IDと一致させる。
EXPECTED_GCP_PROJECT_ID=
GCS_EXPORT_BUCKET=
GCS_BACKUP_BUCKET=
GCS_REPLICA_BUCKET=
GCS_AUDIT_BUCKET=
# バックアップワークフローの設定値です。GitHubのstaging/production Environmentsに設定してください。
# バックアップワークフローはGitHub Actions OIDCで認証します。
# アプリケーションの .env.local やVercel環境には設定不要です。
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_BACKUP_SERVICE_ACCOUNT=
# アプリ側からGCS/Vertexを呼び出す際、Workload Identityを使えない環境で使用する実行時認証情報です。
# サーバー専用とし、バックアップ用OIDCとは分けて管理してください。
GCP_SERVICE_ACCOUNT_KEY_JSON=

# Google Cloud Vertex AI
VERTEX_AI_LOCATION=asia-northeast1
VERTEX_AI_MODEL=gemini-3.5-flash

# Google OAuth（staging/productionでは必須）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 障害通知（staging/productionでは必須）
DISCORD_ALERT_WEBHOOK_URL=
