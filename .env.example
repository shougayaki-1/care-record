NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Do not expose these with NEXT_PUBLIC_.
GAS_API_URL=
GAS_SHARED_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 鍵ローテーション用。例: {"2026-01":"base64...","2026-07":"base64..."}
# 新規暗号化はACTIVE_KEY_IDを使用し、復号中の旧鍵はkeyringへ残す。
GOOGLE_TOKEN_ENCRYPTION_KEYS=
GOOGLE_TOKEN_ACTIVE_KEY_ID=
AUDIT_IP_HASH_SALT=
# 保持期間切れデータ消去ジョブ(/api/cron/purge)の認可シークレット。Vercel Cron と共有する。
CRON_SECRET=

# 本番では必須。application/octet-stream を受け取り {"clean": true} を返す検査サービス。
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# 別アカウント/WORM相当の監査アーカイブ受信先。署名検証と重複排除を実装すること。
AUDIT_ARCHIVE_URL=
AUDIT_ARCHIVE_HMAC_SECRET=

# Google Cloud Storage バックアップ
GCP_PROJECT_ID=
# サービスアカウント JSON をそのまま文字列として設定（Vercel 対応）
GCP_SERVICE_ACCOUNT_KEY_JSON=
