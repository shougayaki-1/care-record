{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/archive-audit",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/backup-daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/backup-monthly",
      "schedule": "0 2 1 * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/issue-56-continuous-worker": false,
      "codex/issue-56-keyring-follow-up": false,
      "codex/worker-worktree-verification": false,
      "codex/issue-51-dx-npm-run-test": false,
      "codex/issue-50-a11y-input": false,
      "codex/issue-70-worker-self-repair": false,
      "codex/enable-worker-status": false,
      "codex/controller-idle-heartbeat": false,
      "codex/status-fixed-script-download": false,
      "codex/issue-59-notifications": false,
      "codex/issue-59-notifications-review": false
    }
  }
}
